        <w:body>
          <w:p><w:pPr><w:pStyle w:val="ExportHeading1"/></w:pPr><w:r><w:t>Synthetic export fixture</w:t></w:r></w:p>
          <w:p><w:pPr><w:pStyle w:val="ExportBody"/></w:pPr><w:r><w:t xml:space="preserve">Contents: </w:t></w:r><w:hyperlink w:anchor="_Toc300001"><w:r><w:t>Background</w:t></w:r></w:hyperlink></w:p>
          <w:p><w:pPr><w:pStyle w:val="ExportBody"/></w:pPr><w:r><w:t xml:space="preserve">1 The first paragraph states a synthetic proposition.</w:t></w:r><w:r><w:rPr><w:vertAlign w:val="superscript"/></w:rPr><w:footnoteReference w:id="1"/></w:r></w:p>
          <w:p><w:pPr><w:pStyle w:val="ExportBody"/></w:pPr><w:r><w:t xml:space="preserve">2 As noted at [</w:t></w:r><w:hyperlink w:anchor="_Ref300001"><w:r><w:t>1</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">] above, and see note </w:t></w:r><w:hyperlink w:anchor="_Ref300002"><w:r><w:t>2</w:t></w:r></w:hyperlink><w:r><w:t>.</w:t></w:r><w:r><w:rPr><w:vertAlign w:val="superscript"/></w:rPr><w:footnoteReference w:id="2"/></w:r></w:p>
          <w:p><w:pPr><w:pStyle w:val="ExportBody"/></w:pPr><w:r><w:t xml:space="preserve">3 The evidence is summarised below.</w:t></w:r><w:r><w:rPr><w:vertAlign w:val="superscript"/></w:rPr><w:footnoteReference w:id="3"/></w:r><w:r><w:rPr><w:vertAlign w:val="superscript"/></w:rPr><w:footnoteReference w:id="4"/></w:r></w:p>
          <w:p><w:pPr><w:pStyle w:val="ExportQuote"/></w:pPr><w:r><w:t>A synthetic block quotation.</w:t></w:r></w:p>
          <w:sectPr/>
