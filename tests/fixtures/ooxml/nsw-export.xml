        <w:footnote w:id="2"><w:p><w:pPr><w:pStyle w:val="FootnoteText"/></w:pPr><w:r><w:footnoteRef/></w:r><w:r><w:t xml:space="preserve"> T 12.5; Exhibit A at 3.</w:t></w:r></w:p></w:footnote>
        <w:footnote w:id="3"><w:p><w:pPr><w:pStyle w:val="FootnoteText"/></w:pPr><w:r><w:footnoteRef/></w:r><w:r><w:t xml:space="preserve"> The witness was not cross-examined on this point.</w:t></w:r></w:p></w:footnote>
        <w:footnote w:id="4"><w:p><w:pPr><w:pStyle w:val="FootnoteText"/></w:pPr><w:r><w:footnoteRef/></w:r><w:r><w:t xml:space="preserve"> That approach was not followed in </w:t></w:r><w:r><w:rPr><w:i/></w:rPr><w:t>Fictional Holdings Ltd v Placeholder</w:t></w:r><w:r><w:t xml:space="preserve"> [2002] NSWCA 2 at [8], for the reasons given there.</w:t></w:r></w:p></w:footnote>
